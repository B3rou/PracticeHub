@model OOPHw.Models.Movie

@{
    ViewData["Title"] = Model.Title + " - Film Detayı";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none ps-0">
            <i class="bi bi-arrow-left me-1"></i>Film Listesine Dön
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm overflow-hidden">
                <div class="row g-0">
                    <!-- Left Side: Poster -->
                    <div class="col-md-3 bg-dark d-flex align-items-center justify-content-center" style="min-height: 350px;">
                        @if (!string.IsNullOrEmpty(Model.PosterPath))
                        {
                            <img src="@Model.PosterPath" class="img-fluid w-100 h-100 object-fit-cover" alt="@Model.Title" style="max-height: 420px;" />
                        }
                        else
                        {
                            <div class="text-white-50 text-center p-4">
                                <i class="bi bi-image display-4 mb-2"></i>
                                <h6 class="fw-light">Bu film için afiş eklenmemiş.</h6>
                            </div>
                        }
                    </div>

                    <!-- Right Side: Text Details -->
                    <div class="col-md-9">
                        <div class="card-body p-4 p-md-5 h-100 d-flex flex-column">
                            
                            <!-- Genre and Rating row -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-primary fs-6 px-3 py-2">@Model.Genre</span>
                                <div class="d-flex align-items-center">
                                    <span class="fs-4 fw-bold text-warning me-2"><i class="bi bi-star-fill"></i></span>
                                    <span class="fs-4 fw-bold text-dark">@Model.Rating.ToString("0.0")</span>
                                    <span class="text-muted fs-6 ms-1">/ 10</span>
                                </div>
                            </div>

                            <!-- Title & Favorite status -->
                            <div class="d-flex align-items-center mb-4">
                                <h1 class="display-5 fw-bold text-dark mb-0 me-3">@Model.Title</h1>
                                <form asp-action="ToggleFavorite" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-outline-danger border-0 shadow-sm rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;" title="@(Model.IsFavorite ? "Favorilerden Çıkar" : "Favorilere Ekle")">
                                        @if (Model.IsFavorite)
                                        {
                                            <i class="bi bi-heart-fill fs-4 text-danger"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-heart fs-4"></i>
                                        }
                                    </button>
                                </form>
                            </div>

                            <!-- Main Details List -->
                            <div class="row g-3 mb-4 fs-5 text-secondary">
                                <div class="col-sm-4 fw-bold text-dark"><i class="bi bi-person me-2"></i>Yönetmen:</div>
                                <div class="col-sm-8">@Model.Director</div>

                                <div class="col-sm-4 fw-bold text-dark"><i class="bi bi-calendar-event me-2"></i>Yayın Yılı:</div>
                                <div class="col-sm-8">@Model.ReleaseYear</div>
                            </div>

                            <hr class="my-4">

                            <!-- Footer/Actions -->
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success btn-lg px-4">
                                    <i class="bi bi-pencil-square me-2"></i>Film Bilgilerini Düzenle
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-lg px-4">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
