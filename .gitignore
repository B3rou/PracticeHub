*.unsuccessfulbuild

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Publish / Deploy outputs
publish/
*.publish.htm
*.pubxml
*.pubxml.user

# ------------------------------------------------------------------------------
# 3. Databases (SQLite, Local DBs, Backups)
